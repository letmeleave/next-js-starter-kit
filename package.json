{
  "name": "nextjs-starter-kit",
  "version": "2.0.0",
  "license": "ISC",
  "private": true,
  "browserslist": [
    "defaults",
    "last 2 versions",
    "not IE 11",
    "> 0.5%"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "tsc && next lint --fix",
    "start": "PORT=4006 NODE_ENV=production next start",
    "analyze": "ANALYZE=true next build",
    "favicons": "real-favicon generate src/assets/meta/meta-description.json src/assets/meta/meta-data.json ./public/meta && cpy public/meta/favicon.ico public",
    "prepare": "husky install",
    "component": "node create-component.js"
  },
  "dependencies": {
    "@artsy/fresnel": "^3.1.0",
    "@next/bundle-analyzer": "^10.2.2",
    "axios": "^0.21.1",
    "classnames": "^2.3.1",
    "dotenv": "^9.0.2",
    "express": "^4.17.1",
    "html-react-parser": "^1.2.6",
    "http": "^0.0.1-security",
    "https": "^1.0.0",
    "next": "^12.0.1",
    "next-cookies": "^2.0.3",
    "next-pwa": "^5.6.0",
    "next-redux-wrapper": "^6.0.2",
    "normalize.css": "^8.0.1",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-redux": "^7.2.4",
    "redux": "^4.0.5",
    "redux-devtools-extension": "^2.13.9",
    "redux-thunk": "^2.3.0",
    "sass": "^1.35.2",
    "styled-components": "^5.3.5"
  },
  "devDependencies": {
    "@babel/core": "^7.8.3",
    "@babel/plugin-proposal-class-properties": "^7.12.1",
    "@babel/plugin-proposal-decorators": "^7.12.1",
    "@svgr/webpack": "^5.5.0",
    "@types/body-scroll-lock": "^3.1.0",
    "@types/node": "^16.0.1",
    "@types/react": "^18.0.0",
    "@types/react-redux": "^7.1.18",
    "@types/webpack-env": "^1.16.0",
    "@typescript-eslint/eslint-plugin": "^4.31.1",
    "@typescript-eslint/parser": "^4.31.1",
    "cli-real-favicon": "^0.0.8",
    "cpy-cli": "^3.1.1",
    "eslint": "^7.30.0",
    "eslint-config-airbnb": "^18.2.1",
    "eslint-config-airbnb-typescript": "^14.0.0",
    "eslint-config-next": "^12.0.3",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-import": "^2.24.2",
    "eslint-plugin-jsx-a11y": "^6.4.1",
    "eslint-plugin-react": "^7.25.1",
    "eslint-plugin-react-hooks": "^4.2.0",
    "eslint-plugin-simple-import-sort": "^7.0.0",
    "husky": "^7.0.0",
    "jira-prepare-commit-msg": "^1.6.1",
    "pinst": "^2.1.6",
    "react-useportal": "^1.0.16",
    "sass-resources-loader": "^2.2.1",
    "swagger-typescript-api": "^9.2.0",
    "typescript": "^4.2.4"
  },
  "jira-prepare-commit-msg": {
    "messagePattern": "$J $M",
    "jiraTicketPattern": "([A-Z]+-\\d+)",
    "commentChar": "#",
    "isConventionalCommit": false,
    "allowEmptyCommitMessage": false
  }
}
